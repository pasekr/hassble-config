devices:
- id: "obd_vehicle"
  name: "Wican"
  source: "obd"
  obd: {}
  sensors:
  - key: "battery_voltage"
    device_class: "voltage"
    unit: "V"
    state_class: "measurement"
    accuracy_decimals: 2
    preset: "battery_voltage"
    pid: "42"
    formula: "(a*256+b)/1000"
  - key: "coolant_temp"
    device_class: "temperature"
    unit: "°C"
    state_class: "measurement"
    icon: "mdi:coolant-temperature"
    accuracy_decimals: 1
    preset: "coolant_temp"
    pid: "05"
    formula: "a-40"
    update_interval: "10s"
  - key: "fuel_level"
    unit: "%"
    state_class: "measurement"
    icon: "mdi:gas-station"
    accuracy_decimals: 1
    preset: "fuel_level"
    pid: "2F"
    formula: "a/2.55"
    update_interval: "30s"
  - key: "odometer"
    device_class: "distance"
    unit: "km"
    state_class: "total_increasing"
    accuracy_decimals: 1
    preset: "odometer"
    pid: "A6"
    formula: "(a*16777216+b*65536+c*256+d)/10"
    update_interval: "30s"
  - key: "speed"
    device_class: "speed"
    unit: "km/h"
    state_class: "measurement"
    icon: "mdi:speedometer"
    accuracy_decimals: 0
    preset: "speed"
    pid: "0D"
    formula: "a"
    update_interval: "1s"
- id: "obd_link_cx"
  name: "OBDlink CX"
  source: "obd"
  obd: {}
  sensors:
  - key: "odometer"
    device_class: "distance"
    unit: "km"
    state_class: "total_increasing"
    accuracy_decimals: 1
    preset: "odometer"
    pid: "A6"
    formula: "(a*16777216+b*65536+c*256+d)/10"
    update_interval: "30s"
  - key: "speed"
    device_class: "speed"
    unit: "km/h"
    state_class: "measurement"
    icon: "mdi:speedometer"
    accuracy_decimals: 0
    preset: "speed"
    pid: "0D"
    formula: "a"
    update_interval: "1s"

